# DB_CONNECTION_STRING=Server=localhost,1433;Database=test;User Id=sa;Password=12345678Aa;TrustServerCertificate=True;

# Dùng chuỗi này CHỈ ĐỂ KIỂM TRA ĐĂNG NHẬP.
AUTH_DB_CONNECTION_STRING="Data Source=localhost,1433;Initial Catalog=test1;User ID=user_app_login;Password=UserAppPassword@123;TrustServerCertificate=True"

# Dùng chuỗi này cho người dùng có vai trò 'user' SAU KHI họ đăng nhập thành công.
USER_DB_CONNECTION_STRING="Data Source=localhost,1433;Initial Catalog=test1;User ID=user_app_login;Password=UserAppPassword@123;TrustServerCertificate=True"

# Dùng chuỗi này cho người dùng có vai trò 'admin' SAU KHI họ đăng nhập thành công.
ADMIN_DB_CONNECTION_STRING="Data Source=localhost,1433;Initial Catalog=test1;User ID=admin_app_login;Password=AdminAppPassword@123;TrustServerCertificate=True"